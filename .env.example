# No secrets are used by this site. These are optional build-time settings.

# Public address of the deployed site, no trailing slash. Needed for the sitemap,
# canonical links and social-sharing preview images (they must be absolute URLs).
# Netlify and Vercel supply this automatically on their own build servers.
SITE_URL=https://your-site-name.netlify.app

# Only if the site is served from a sub-folder, e.g. GitHub Pages project sites: /portfolio
BASE_PATH=

# Search engines are told NOT to list the site by default (it is meant to be shared by link).
# To let Google list it: set ALLOW_INDEXING=1 and remove the X-Robots-Tag lines from
# static_root/_headers, netlify.toml and vercel.json.
ALLOW_INDEXING=
